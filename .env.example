# Copy to .env and fill in. .env is gitignored.

# OpenRouter (one key covers chat and embeddings)
# chat and embedding model IDs are prefixed, e.g. openai/gpt-4o-mini
MEM_API_KEY=
MEM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MEM_CHAT_MODEL=openai/gpt-4o-mini
MEM_EMBED_MODEL=openai/text-embedding-3-small
MEM_EMBED_DIMS=1536

# Cross-family judge used by the evaluation harness (any other family on the same key)
MEM_JUDGE_MODEL=

# Postgres (docker compose in infra/)
# Postgres (docker compose in infra/) — 127.0.0.1, NOT localhost (IPv6 hang)
MEM_DATABASE_URL=postgresql://acme:acme_local_dev@127.0.0.1:15432/agentmem
MEM_DATABASE_URL_LG=postgresql://acme:acme_local_dev@127.0.0.1:15432/agentmem_lg
